# Public browser configuration only. Never place provider client secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Add this exact URL to Supabase Auth's redirect allow list (use your Render frontend URL in production, e.g. https://<your-fe-app>.onrender.com).
VITE_AUTH_REDIRECT_URL=http://localhost:5173/

# Add com.fairshare.app://** to the same allow list for installed Android/iOS builds.
VITE_NATIVE_AUTH_REDIRECT_URL=com.fairshare.app://auth/callback

# Backend API base URL.
# Local development: http://localhost:8080/api/v1
# Render deployed backend: https://YOUR-APP-NAME.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1
