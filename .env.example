# Public frontend configuration only. Provider client secrets belong in the backend environment.
VITE_NATIVE_AUTH_REDIRECT_URL=com.fairshare.app://auth/callback

# Backend API base URL.
# Local development: http://localhost:8080/api/v1
# Production deployed backend: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1
